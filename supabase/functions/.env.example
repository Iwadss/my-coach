# Copy this file to `supabase/functions/.env` and fill in real values once
# you have a Stripe account (test mode). That file is gitignored and
# auto-loaded by `supabase start` — after editing it, run
# `supabase stop && supabase start` to pick up the change (the edge-runtime
# container only reads it at startup).
#
# Never paste the secret key or webhook secret into chat — set them here
# directly.

# Dashboard -> Developers -> API keys -> Secret key (test mode: sk_test_...)
STRIPE_SECRET_KEY=

# No Stripe Price object needed — create-checkout-session builds a one-time
# RM50 Checkout Session inline (price_data), amount set by
# SUBSCRIPTION_PRICE_MYR in supabase/functions/_shared/stripe.ts.

# Only needed for local testing: `stripe listen --forward-to
# http://127.0.0.1:54421/functions/v1/stripe-webhook --print-secret` (or
# the "Signing secret" shown when you add a webhook endpoint in the
# Dashboard for production). Starts with whsec_...
STRIPE_WEBHOOK_SECRET=

# Where Checkout should redirect back to (the coach dashboard). Matches the
# Vite dev server; change for a deployed frontend.
SITE_URL=http://localhost:5173
